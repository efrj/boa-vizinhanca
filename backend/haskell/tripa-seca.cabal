cabal-version:      2.4
name:               tripa-seca
version:            0.1.0.0
executable tripa-seca
    main-is:          Main.hs
    build-depends:    base >=4.14 && <5
                    , aeson
                    , text
                    , bytestring
                    , warp
                    , wai
                    , http-types
                    , random
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    default-language: Haskell2010
